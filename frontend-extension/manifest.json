{
  "manifest_version": 3,
  "name": "BookStack",
  "version": "1.0",
  "description": "Frictionless bookmark saving and metadata extraction.",
  "icons": {
    "16": "assets/icon16.svg",
    "48": "assets/icon48.svg",
    "128": "assets/icon128.svg"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://bookstack-api-0ir4.onrender.com/*",
    "https://bookstack-web.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to BookStack",
    "default_icon": {
      "16": "assets/icon16.svg",
      "48": "assets/icon48.svg",
      "128": "assets/icon128.svg"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://bookstack-web.onrender.com/*", "*://*.bookstack.com/*"],
      "js": ["content/auth-sync.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Save current tab to BookStack"
    }
  }
}
